# Server-side: enables the LLM compiler (/api/compile).
# Free Tier (Recommended): Get a free API key at https://aistudio.google.com with zero cost
GEMINI_API_KEY=
# Optional: override default Gemini model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Or use Claude (Anthropic):
ANTHROPIC_API_KEY=
# Optional overrides (defaults come from contracts/deployments/injective-testnet.json via `pnpm sync`)
NEXT_PUBLIC_ZHI_FACTORY=
NEXT_PUBLIC_ZHI_ATTESTOR=
NEXT_PUBLIC_ZHI_CREDIT_POOL=
# Hosted harness address pre-filled in the deploy panel
NEXT_PUBLIC_ZHI_HARNESS=
NEXT_PUBLIC_INJ_RPC=https://k8s.testnet.json-rpc.injective.network
